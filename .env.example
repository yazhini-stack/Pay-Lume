# Paylume Frontend Configuration
# ------------------------------

# Set to "true" to use local high-fidelity mock client, or "false" to connect to real FastAPI backend
NEXT_PUBLIC_USE_MOCK_API=false

# URL of real FastAPI backend (used when NEXT_PUBLIC_USE_MOCK_API=false)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth Configuration (PUBLIC FRONTEND-SAFE VALUES ONLY)
# Never expose SUPABASE_SERVICE_ROLE_KEY here!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here
